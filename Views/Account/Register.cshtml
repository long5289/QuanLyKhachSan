@model HotelBooking.Web.Models.RegisterViewModel
@{ ViewData["Title"] = "Đăng ký"; }
<div class="container py-5 account-page"><p class="eyebrow">TÀI KHOẢN MỚI</p><h1>Bắt đầu hành trình.</h1><form asp-action="Register" method="post" class="form-panel"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" /><label asp-for="Email"></label><input asp-for="Email" class="form-control" /><label asp-for="Phone"></label><input asp-for="Phone" class="form-control" /><label asp-for="Password"></label><input asp-for="Password" class="form-control" /><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" /><button class="primary-action" type="submit">Tạo tài khoản</button><p>Đã có tài khoản? <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập</a></p></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }