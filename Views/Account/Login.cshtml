@model HotelBooking.Web.Models.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="container py-5 account-page"><p class="eyebrow">TÀI KHOẢN</p><h1>Chào mừng trở lại.</h1><form asp-action="Login" method="post" class="form-panel"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Email"></label><input asp-for="Email" class="form-control" /><label asp-for="Password"></label><input asp-for="Password" class="form-control" /><button class="primary-action" type="submit">Đăng nhập</button><p>Chưa có tài khoản? <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký</a></p></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }