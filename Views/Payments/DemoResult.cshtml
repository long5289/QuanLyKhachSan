@model HotelBooking.Web.Models.Booking
@{ ViewData["Title"] = "Kết quả thanh toán demo"; }
<div class="container py-5 success-panel"><p class="eyebrow">THANH TOÁN DEMO THÀNH CÔNG</p><h1>Đã ghi nhận thanh toán.</h1><p>Booking #@Model.Id · @Model.Room.Name</p><p>Số tiền mô phỏng: <strong>@Model.Payment?.Amount.ToString("N0") VNĐ</strong></p><p>Mã giao dịch: <code>@Model.Payment?.TransactionCode</code></p><p class="payment-note">Đây không phải giao dịch tiền thật. Khi triển khai chính thức, cần thay màn demo bằng trang hosted của cổng thanh toán.</p><a class="primary-action d-inline-block me-2" asp-controller="Bookings" asp-action="Details" asp-route-id="@Model.Id">Xem chi tiết / thêm dịch vụ</a><a class="secondary-action d-inline-block" asp-controller="Bookings" asp-action="Mine">Xem lịch đặt phòng</a></div>