@model HotelBooking.Web.Models.AdminReportViewModel
@{ ViewData["Title"] = "Báo cáo"; }
<div class="container py-5 admin-page"><div class="admin-heading"><div><p class="eyebrow">BÁO CÁO THỐNG KÊ</p><h1>Tổng quan hoạt động</h1></div><a asp-action="Index">← Tổng quan</a></div><div class="stats-grid"><div class="stat-card"><span>Doanh thu xác nhận</span><strong>@Model.ConfirmedRevenue.ToString("N0")</strong></div><div class="stat-card"><span>Đặt phòng hoàn tất</span><strong>@Model.CompletedBookings</strong></div><div class="stat-card"><span>Tổng khách hàng</span><strong>@Model.TotalCustomers</strong></div></div><h2 class="section-title">Lượt đặt theo phòng</h2><div class="table-wrap"><table class="table"><thead><tr><th>Phòng</th><th>Số lượt đặt</th></tr></thead><tbody>@foreach (var item in Model.RoomOccupancy) { <tr><td>@item.RoomName</td><td>@item.BookingCount</td></tr> }</tbody></table></div></div>