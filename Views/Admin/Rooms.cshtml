@model HotelBooking.Web.Models.AdminRoomsViewModel
@{ ViewData["Title"] = "Quản lý phòng"; }
<div class="container py-5 admin-page"><div class="admin-heading"><div><p class="eyebrow">QUẢN LÝ PHÒNG</p><h1>Danh sách phòng</h1></div><div class="admin-actions"><a class="primary-action" href="#add-room">+ Thêm phòng</a><a asp-action="Index">← Tổng quan</a></div></div>
    <form id="add-room" asp-action="AddRoom" method="post" class="admin-form"><h2>Thêm phòng mới</h2><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="NewRoom.Code" placeholder="Mã phòng" /><input asp-for="NewRoom.Name" placeholder="Tên phòng" /><input asp-for="NewRoom.Type" placeholder="Loại phòng" /><input asp-for="NewRoom.Capacity" placeholder="Sức chứa" /><input asp-for="NewRoom.PricePerNight" placeholder="Giá / đêm" /><button class="primary-action" type="submit">Lưu phòng mới</button></form>
    <div class="table-wrap mt-5"><table class="table"><thead><tr><th>Mã</th><th>Tên phòng</th><th>Loại</th><th>Sức chứa</th><th>Giá</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var room in Model.Rooms) { var formId = $"room-{room.Id}"; <tr><td><form id="@formId" asp-action="UpdateRoom" method="post"></form><input form="@formId" type="hidden" name="Id" value="@room.Id" /><input form="@formId" name="Code" value="@room.Code" /></td><td><input form="@formId" name="Name" value="@room.Name" /></td><td><input form="@formId" name="Type" value="@room.Type" /></td><td><input form="@formId" name="Capacity" type="number" min="1" value="@room.Capacity" /></td><td><input form="@formId" name="PricePerNight" type="number" min="0" value="@room.PricePerNight" /></td><td><select form="@formId" name="Status">@foreach (var status in Enum.GetValues<HotelBooking.Web.Models.RoomStatus>()) { <option value="@status" selected="@(status == room.Status)">@status</option> }</select></td><td><button form="@formId" class="table-action" type="submit">Lưu</button><form asp-action="DeleteRoom" method="post"><input type="hidden" name="id" value="@room.Id" /><button class="table-action" type="submit">Xóa</button></form></td></tr> }</tbody></table></div>
</div>