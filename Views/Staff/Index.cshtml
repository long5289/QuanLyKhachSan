@model IReadOnlyList<HotelBooking.Web.Models.Booking>
@{ ViewData["Title"] = "Nghiệp vụ nhân viên"; }
<div class="container py-5 admin-page"><div class="admin-heading"><div><p class="eyebrow">KHU VỰC NHÂN VIÊN</p><h1>Nhận và trả phòng</h1></div><span>@Context.Session.GetString("AccountName")</span></div>
    @if (Model.Count == 0) { <p>Hiện không có booking cần xử lý.</p> }
    <div class="table-wrap"><table class="table align-middle"><thead><tr><th>Khách hàng</th><th>Phòng</th><th>Ngày ở</th><th>Thanh toán</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
    @foreach (var booking in Model)
    {
        <tr><td>@booking.Customer.FullName<br /><small>@booking.Customer.Phone</small></td><td>@booking.Room.Name</td><td>@booking.CheckIn.ToString("dd/MM/yyyy") - @booking.CheckOut.ToString("dd/MM/yyyy")</td><td>@booking.Payment?.Status @if (booking.Status == BookingStatus.Cancelled && booking.Payment?.Status == PaymentStatus.Paid) { <br /><small class="refund-required">Cần hoàn tiền</small> }</td><td>@booking.Status</td><td class="payment-actions">
            @if (booking.Status == BookingStatus.Pending) { <form asp-action="SetStatus" method="post"><input type="hidden" name="id" value="@booking.Id" /><input type="hidden" name="status" value="Confirmed" /><button class="table-action" type="submit">Xác nhận</button></form><form asp-action="SetStatus" method="post"><input type="hidden" name="id" value="@booking.Id" /><input type="hidden" name="status" value="Cancelled" /><button class="table-action" type="submit">Từ chối</button></form> }
            @if (booking.Status == BookingStatus.Confirmed) { <form asp-action="SetStatus" method="post"><input type="hidden" name="id" value="@booking.Id" /><input type="hidden" name="status" value="CheckedIn" /><button class="table-action" type="submit">Nhận phòng</button></form> }
            @if (booking.Status == BookingStatus.CheckedIn) { <form asp-action="SetStatus" method="post"><input type="hidden" name="id" value="@booking.Id" /><input type="hidden" name="status" value="Completed" /><button class="table-action" type="submit">Trả phòng</button></form> }
            @if (booking.Status == BookingStatus.Cancelled && booking.Payment?.Status == PaymentStatus.Paid) { <form asp-action="MarkRefunded" method="post" onsubmit="return confirm('Xác nhận đã hoàn tiền cho booking #@booking.Id?')"><input type="hidden" name="id" value="@booking.Id" /><button class="table-action refund-action" type="submit">Xác nhận hoàn tiền</button></form> }
        </td></tr>
    }
    </tbody></table></div>
</div>