<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Royal Hotel</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ROYAL HOTEL <small>ĐẶT PHÒNG TRỰC TUYẾN</small></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Rooms" asp-action="Index">Phòng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Về khách sạn</a>
                        </li>
                        @if (Context.Session.GetString("AccountRole") == "Admin")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Quản trị</a></li>
                        }
                        @if (Context.Session.GetString("AccountRole") is "Staff" or "Admin")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Staff" asp-action="Index">Nghiệp vụ</a></li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Services" asp-action="Index">Dịch vụ</a>
                        </li>
                        @if (Context.Session.GetString("AccountEmail") is not null)
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Bookings" asp-action="Mine">Lịch đặt</a></li>
                        }
                    </ul>
                    <div class="account-links">
                        @if (Context.Session.GetString("AccountName") is string accountName)
                        { <span>@accountName</span><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Đăng xuất</button></form> }
                        else
                        { <a asp-controller="Account" asp-action="Login">Đăng nhập</a><a asp-controller="Account" asp-action="Register">Đăng ký</a> }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 Royal Hotel - <a asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách riêng tư</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
